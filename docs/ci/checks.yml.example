name: PostgreSQL boundary checks
on: [push, pull_request]
permissions:
  contents: read
jobs:
  verify:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: pip install -r requirements-dev.txt
      - run: python -m ruff check management scripts tests
      - run: python -m ruff format --check management scripts tests
      - run: python -m pytest -q
      - run: python -m openapi_spec_validator openapi.yaml
      - run: python scripts/dev-secrets.py
      - run: docker compose config --quiet
      - run: python tests/integration.py
