# Copy to .env. Values below are OpenBao KV v2 reference names, NEVER passwords.
POSTGRES_ADMIN_SECRET_REF=kv/codestra/postgresql/dev/admin#password
POSTGRES_MONITOR_SECRET_REF=kv/codestra/postgresql/dev/monitor#password
POSTGRES_EXPORTER_SECRET_REF=kv/codestra/postgresql/dev/exporter#password
POSTGRES_BACKUP_KEY_REF=transit/keys/codestra-postgresql-backup
# An OpenBao agent/operator renders those values into these local files.
OPENBAO_RENDER_DIR=./.secrets
MANAGEMENT_PORT=8080
BACKUP_RETENTION_DAYS=14
